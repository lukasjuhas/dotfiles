# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cask "obsidian"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Productivity & menubar
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cask "rectangle"
cask "jordanbaird-ice"   # the only menu bar manager (no Bartender/Dozer)
cask "meetingbar"
cask "linear-linear"
cask "kap"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Utilities
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cask "the-unarchiver"
cask "1password"
cask "flux-app"


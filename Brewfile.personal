# Personal-laptop layer (on top of `Brewfile` + `Brewfile.laptop`).
# Never installed on the work laptop. See `Brewfile` for the layers.

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Photo & design
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

cask "adobe-creative-cloud"   # install Lightroom / Photoshop from the CC app

# Camera tethering & scanner libraries (filmscan workflow).
brew "libgphoto2"
brew "sane-backends"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Databases
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

brew "mysql", restart_service: :changed

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Files & torrents
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

brew "transmission-cli"
cask "transmission"
cask "transmit"

